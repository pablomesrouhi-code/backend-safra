# TikTok Events API (optional)
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# Snapchat Conversions API (optional)
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

# Order settings
