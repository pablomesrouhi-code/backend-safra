# Safra Skin Backend — copy to .env (local) or Easypanel env vars (production)

# ── Database ──
# Local dev:
DATABASE_URL=sqlite:///./safraskin.db
# Easypanel (uncomment and remove SQLite line above):
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@safraskin_database:5432/safraskin?sslmode=disable

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://safraskin.online,https://www.safraskin.online,http://localhost:3000

# ── Google Sheets (optional — orders still save to DB if empty) ──
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SECRET=

# ── Meta CAPI (optional) ──
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ── TikTok Events API (optional) ──
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# ── Snapchat CAPI (optional) ──
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

# ── Orders ──
ORDER_NUMBER_PREFIX=SS
UPSELL_PRICE_SAR=99
