# Safra Skin Backend — copy to .env (local) or Easypanel env vars (production)

# ── Database ──
# Local dev:
DATABASE_URL=sqlite:///./safraskin.db
# Easypanel (use internal DB hostname from your database service):
# DATABASE_URL=postgres://postgres:YOUR_PASSWORD@safraskin_database:5432/safraskin?sslmode=disable
# Password with special chars (@ # etc.) must be URL-encoded in this string.

# ── Server ──
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://safraskin.online,https://www.safraskin.online,http://localhost:3000

# ── MaxMind GeoLite2 (optional — country from IP for CAPI / fraud) ──
# Create free account: https://www.maxmind.com/en/geolite2/signup
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
MAXMIND_GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb
# Reject orders when IP country is known and not Saudi Arabia:
GEOIP_ENFORCE_KSA=false

# ── Google Sheets (optional — orders still save to DB if empty) ──
# Deploy apps script from docs/sheets/google-apps-script.js to:
# https://docs.google.com/spreadsheets/d/12UOny_tW2vOVclTSe-jLoMeI_KqYZPGZ3TyfjyxBWWw/edit
# Paste the Web app deployment URL below (no secret):
GOOGLE_SHEETS_WEBHOOK_URL=

# ── Meta CAPI (optional) ──
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ── TikTok Events API (optional) ──
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# ── Snapchat CAPI (optional) ──
SNAP_PIXEL_ID=
SNAP_ACCESS_TOKEN=

# ── Orders ──
ORDER_NUMBER_PREFIX=nama
UPSELL_PRICE_SAR=99
